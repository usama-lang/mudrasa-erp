/node_modules
/public/images/uploads
/public/hot
/public/uploads
/public/modules
/public/storage
/storage/*.key
/vendor
/bootstrap/cache/*.php
.env
.env.local
.env.production
.env.backup
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
.DS_Store
public/.DS_Store
public/images/.DS_Store
public/images/modules

# Modules are tracked directly in this repo so a plain `git pull` keeps them
# in sync across systems. Each module still manages its own vendor/node_modules
# via its own nested .gitignore.
/modules/*/vendor/
/modules/*/node_modules/

# User translations.
/resources/user-lang/*
!/resources/user-lang/.gitkeep

# Exclude release builds
/releases

# Exclude module-specific builds (e.g., build-crm, build-hrm)
/public/build-*
.composer

# Eclude zip/tar.gz release packages
*.zip
*.tar.gz
